# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# resident data — NEVER commit any of this.
# Document bytes live outside the repo at AUDIT_DATA_DIR. These patterns are a
# second line of defence in case that is ever misconfigured.
/data/
*.sqlite
*.sqlite-journal
*.db
*.pdf
*.docx
*.doc
*.xlsx

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
