# Copy to .env.local and set for this workstation. Never commit .env.local.

# Where document bytes are written. MUST be outside this repository.
# Resident files are special category data; keeping them in the project folder
# risks committing them, and this repo is a code repo only.
AUDIT_DATA_DIR=/absolute/path/outside/this/repo/SupportAudit/data

# SQLite database file. Also outside the repo.
DATABASE_URL="file:/absolute/path/outside/this/repo/SupportAudit/audit.sqlite"
